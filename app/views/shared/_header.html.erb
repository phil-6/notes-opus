<header>
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-6">
        <%= link_to t("application.name"), root_path, class: "text-xl font-bold header-title no-underline" %>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to new_note_path,
            class: "btn-primary",
            data: { turbo_frame: "modal" },
            title: t("notes.index.new_note") do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span class="hidden sm:inline"><%= t("notes.index.new_note") %></span>
        <% end %>

        <button type="button"
                id="theme-toggle"
                class="theme-toggle"
                title="<%= t('header.toggle_dark_mode') %>"
                data-controller="dark-mode"
                data-action="click->dark-mode#toggle"
                aria-label="<%= t('header.toggle_dark_mode') %>">
          <!-- Moon icon - shown in light mode -->
          <svg class="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
          <!-- Sun icon - shown in dark mode -->
          <svg class="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </button>

        <div class="relative" data-controller="dropdown">
          <button type="button"
                  id="user-menu-button"
                  class="flex items-center text-sm user-menu-button"
                  data-action="click->dropdown#toggle"
                  aria-expanded="false"
                  aria-haspopup="true">
            <span class="hidden sm:inline"><%= current_user.display_name %></span>
            <svg class="w-5 h-5 sm:ml-1 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </button>

          <div class="hidden absolute right-0 mt-2 w-48 dropdown-menu rounded-md py-1 z-10"
               id="user-menu"
               data-dropdown-target="menu"
               role="menu"
               aria-orientation="vertical"
               aria-labelledby="user-menu-button">
            <%= link_to t("header.archived"), archived_notes_path,
                class: "block px-4 py-2 text-sm dropdown-item no-underline",
                role: "menuitem" %>
            <%= link_to t("header.tags"), tags_path,
                class: "block px-4 py-2 text-sm dropdown-item no-underline",
                role: "menuitem" %>
            <%= link_to t("header.connections"), connections_path,
                class: "block px-4 py-2 text-sm dropdown-item no-underline",
                role: "menuitem" %>
            <div class="border-t dropdown-divider my-1"></div>
            <%= button_to t("header.sign_out"), session_path,
                method: :delete,
                class: "block w-full text-left px-4 py-2 text-sm dropdown-item",
                role: "menuitem" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
