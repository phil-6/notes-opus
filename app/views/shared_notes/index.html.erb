<div class="max-w-7xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6"><%= t("shared_notes.index.title") %></h1>

  <% if @shared_notes.any? %>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      <% @shared_notes.each do |note| %>
        <div class="group relative rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow <%= note_card_class(note.color) %>">
          <%= link_to edit_note_path(note), class: "block", data: { turbo_frame: "modal" } do %>
            <div class="text-xs text-gray-500 dark:text-gray-400 mb-2">
              <%= t("shared_notes.shared_by", name: note.user.display_name) %>
            </div>

            <% if note.title.present? %>
              <h3 class="font-medium text-gray-900 dark:text-white mb-2"><%= note.title %></h3>
            <% end %>

            <div class="text-sm text-gray-600 dark:text-gray-300 line-clamp-6 prose prose-sm dark:prose-invert max-w-none">
              <%= note.content %>
            </div>

            <% if note.tags.any? %>
              <div class="mt-3 flex flex-wrap gap-1">
                <% note.tags.each do |tag| %>
                  <span class="tag-badge"><%= tag.name %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-500 dark:text-gray-400">
      <p><%= t("shared_notes.index.no_shared_notes") %></p>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "modal" %>
