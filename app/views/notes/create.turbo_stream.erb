<%= turbo_stream.prepend "unpinned-notes" do %>
  <%= render "note_card", note: @note, current_user: current_user %>
<% end %>

<%= turbo_stream.remove "empty-state" %>

<% unless params[:autosave] %>
  <%= turbo_stream.update "modal", "" %>

  <%= turbo_stream.prepend "flash-messages" do %>
    <div class="flash-notice px-4 py-3 rounded-lg shadow-lg max-w-sm transition-opacity duration-150"
         role="alert"
         data-controller="flash"
         data-flash-dismiss-after-value="5000">
      <%= t("notes.created") %>
    </div>
  <% end %>
<% end %>
