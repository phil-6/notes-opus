<%= turbo_frame_tag dom_id(note) do %>
  <div id="<%= dom_id(note, :card) %>"
       class="group relative rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow <%= note_card_class(note.color) %>"
       data-note-id="<%= note.id %>">
    <div class="note-actions absolute top-2 right-2 flex items-center gap-1">
      <%= button_to unarchive_note_path(note),
          method: :patch,
          class: "p-1 rounded hover:bg-black/10 opacity-60 hover:opacity-100",
          id: "unarchive-note-#{note.id}",
          title: t("notes.unarchive"),
          aria: { label: t("notes.unarchive") } do %>
        <!-- Unarchive / restore icon -->
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
      <% end %>

      <%= button_to note_path(note),
          method: :delete,
          class: "p-1 rounded hover:bg-black/10 opacity-60 hover:opacity-100 text-red-600",
          id: "delete-note-#{note.id}",
          title: t("notes.delete_permanently"),
          data: { turbo_confirm: t("notes.confirm_delete_permanently") },
          aria: { label: t("notes.delete_permanently") } do %>
        <!-- Delete permanently icon -->
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      <% end %>
    </div>

    <div class="opacity-75">
      <% if note.title.present? %>
        <h3 class="font-medium mb-2 pr-16" style="color: inherit;"><%= note.title %></h3>
      <% end %>

      <div class="text-sm line-clamp-6 prose prose-sm max-w-none" style="color: inherit;">
        <%= note.content %>
      </div>

      <div class="mt-3 text-xs opacity-60">
        <%= t("notes.archived.archived_on", date: l(note.archived_at, format: :short)) %>
      </div>
    </div>
  </div>
<% end %>
