<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("notes.index.title") %></h1>
    <%= link_to t("notes.index.new_note"), new_note_path,
        class: "btn-primary",
        data: { turbo_frame: "modal" } %>
  </div>

  <div id="notes-container">
    <%= render "notes_list", pinned_notes: @pinned_notes, unpinned_notes: @unpinned_notes, shared_notes: @shared_notes %>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
