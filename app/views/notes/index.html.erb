<div class="max-w-7xl mx-auto">
  <!-- Filter bar -->
  <div class="mb-6 flex flex-wrap items-center gap-3" data-controller="filter">
    <% if current_user.tags.any? %>
      <div class="flex flex-wrap gap-2">
        <% current_user.tags.each do |tag| %>
          <%= link_to tag.name,
              notes_path(tag: tag.id),
              class: "filter-tag #{params[:tag].to_s == tag.id.to_s ? 'filter-tag-active' : ''}" %>
        <% end %>
      </div>
    <% end %>

    <% if @shared_notes.any? %>
      <%= link_to t("notes.index.shared_with_me"),
          notes_path(filter: params[:filter] == 'shared' ? nil : 'shared'),
          class: "filter-tag #{params[:filter] == 'shared' ? 'filter-tag-active' : ''}" %>
    <% end %>

    <% if params[:tag].present? || params[:filter].present? %>
      <%= link_to notes_path, class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" do %>
        <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
        <%= t("common.clear_filters") %>
      <% end %>
    <% end %>
  </div>

  <div id="notes-container" data-controller="masonry">
    <%= render "notes_list", pinned_notes: @pinned_notes, unpinned_notes: @unpinned_notes, shared_notes: @shared_notes %>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
