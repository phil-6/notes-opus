<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("versions.index.title") %></h1>
    <%= link_to t("common.back"), notes_path, class: "btn-secondary" %>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-4 p-4">
    <h2 class="font-medium text-gray-900 dark:text-white"><%= @note.title.presence || t("notes.untitled") %></h2>
    <p class="text-sm text-gray-500 dark:text-gray-400">
      <%= t("versions.index.note_info", owner: @note.user.display_name) %>
    </p>
  </div>

  <% if @versions.any? %>
    <div class="space-y-4">
      <% @versions.each do |version| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-gray-900 dark:text-white">
                <%= version.user.display_name %>
              </span>
              <% if version.changes_summary.any? %>
                <div class="flex gap-1">
                  <% version.changes_summary.each do |change| %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                      <%= t("versions.changes.#{change}") %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
            <span class="text-sm text-gray-500 dark:text-gray-400">
              <%= l(version.created_at, format: :long) %>
            </span>
          </div>

          <% if version.title_changed? %>
            <div class="mb-3 p-3 bg-gray-50 dark:bg-gray-700 rounded">
              <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1"><%= t("versions.fields.title") %></p>
              <div class="flex items-center gap-2 text-sm">
                <span class="line-through text-gray-400 dark:text-gray-500"><%= version.previous_title.presence || t("notes.untitled") %></span>
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
                <span class="text-gray-900 dark:text-white font-medium"><%= version.title.presence || t("notes.untitled") %></span>
              </div>
            </div>
          <% end %>

          <% if version.color_changed? %>
            <div class="mb-3 p-3 bg-gray-50 dark:bg-gray-700 rounded">
              <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1"><%= t("versions.fields.color") %></p>
              <div class="flex items-center gap-2 text-sm">
                <span class="inline-flex items-center gap-1">
                  <span class="w-4 h-4 rounded-full color-swatch-<%= version.previous_color %>"></span>
                  <span class="text-gray-600 dark:text-gray-300"><%= version.previous_color&.capitalize %></span>
                </span>
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
                <span class="inline-flex items-center gap-1">
                  <span class="w-4 h-4 rounded-full color-swatch-<%= @note.color %>"></span>
                  <span class="text-gray-900 dark:text-white font-medium"><%= @note.color&.capitalize %></span>
                </span>
              </div>
            </div>
          <% end %>

          <% if version.content.present? %>
            <div class="text-sm text-gray-600 dark:text-gray-300">
              <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1"><%= t("versions.fields.content") %></p>
              <div class="prose prose-sm dark:prose-invert max-w-none bg-gray-50 dark:bg-gray-700 p-3 rounded">
                <%= sanitize version.content %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-500 dark:text-gray-400">
      <p><%= t("versions.index.no_versions") %></p>
    </div>
  <% end %>
</div>
