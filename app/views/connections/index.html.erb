<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6"><%= t("connections.index.title") %></h1>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 dark:text-white mb-4"><%= t("connections.index.add_connection") %></h2>

    <%= form_with url: connections_path, method: :post, class: "flex gap-3" do |form| %>
      <%= form.email_field :email_address,
          placeholder: t("connections.index.email_placeholder"),
          required: true,
          class: "form-input flex-1" %>
      <%= form.submit t("connections.index.add"), class: "btn-primary" %>
    <% end %>
  </div>

  <% if @connections.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
      <ul class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @connections.each do |connection| %>
          <li class="flex items-center justify-between p-4">
            <div>
              <p class="font-medium text-gray-900 dark:text-white"><%= connection.connected_user.display_name %></p>
              <p class="text-sm text-gray-500 dark:text-gray-400"><%= connection.connected_user.email_address %></p>
            </div>
            <%= button_to connection_path(connection),
                method: :delete,
                class: "text-red-600 hover:text-red-700 dark:text-red-400 text-sm",
                data: { turbo_confirm: t("connections.confirm_remove") } do %>
              <%= t("connections.index.remove") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-8 text-gray-500 dark:text-gray-400">
      <p><%= t("connections.index.no_connections") %></p>
    </div>
  <% end %>
</div>
