<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("application.name") %></h1>
      <h2 class="mt-6 text-xl text-gray-600 dark:text-gray-300"><%= t("passwords.new.title") %></h2>
    </div>

    <%= form_with url: passwords_path, id: "password-reset-form", class: "mt-8 space-y-6" do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :email_address, t("passwords.new.email"), class: "form-label" %>
          <%= form.email_field :email_address,
                               id: "password_email_address",
                               required: true,
                               autofocus: true,
                               autocomplete: "email",
                               placeholder: t("passwords.new.email_placeholder"),
                               value: params[:email_address],
                               class: "form-input mt-1" %>
        </div>
      </div>

      <div>
        <%= form.submit t("passwords.new.submit"), id: "password-submit", class: "btn-primary w-full" %>
      </div>

      <div class="text-center text-sm text-gray-600 dark:text-gray-400">
        <%= link_to t("passwords.new.back_to_sign_in"), new_session_path,
            class: "text-blue-600 hover:text-blue-500 dark:text-blue-400 font-medium" %>
      </div>
    <% end %>
  </div>
</div>
